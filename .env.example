# 本地开发用；平台上这些都由平台注入，不用配
PORT=3000
DATABASE_URL=mysql://root:password@127.0.0.1:3306/expiry

# 统一登录与平台消息。不配时本地以「本地用户」匿名运行（只在 NODE_ENV 不是 production 时），也不会发提醒
YH_CLIENT_ID=
YH_CLIENT_SECRET=
YH_WEB_URL=http://localhost:5185
YH_API_URL=http://localhost:3105
YH_APP_URL=http://localhost:3000

# 「今天」和每天 09:00 按哪个时区算，默认 Asia/Shanghai
EXPIRY_TZ=Asia/Shanghai
# 附件放在这里的 attachments/ 下，平台上是 /data（会进备份）。本地开发用 ./data
EXPIRY_DATA_DIR=./data
